#!/usr/bin/env bash
# cgstack-review-read — read review log and config for dashboard
# Usage: cgstack-review-read
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/cgstack-slug" 2>/dev/null)"
CGSTACK_HOME="${CGSTACK_HOME:-$HOME/.cgstack}"
cat "$CGSTACK_HOME/projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null || echo "NO_REVIEWS"
echo "---CONFIG---"
"$SCRIPT_DIR/cgstack-config" get skip_eng_review 2>/dev/null || echo "false"
echo "---HEAD---"
git rev-parse --short HEAD 2>/dev/null || echo "unknown"
