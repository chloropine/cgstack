#!/usr/bin/env bash
# cgstack-review-log — atomically log a review result
# Usage: cgstack-review-log '{"skill":"...","timestamp":"...","status":"..."}'
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/cgstack-slug" 2>/dev/null)"
CGSTACK_HOME="${CGSTACK_HOME:-$HOME/.cgstack}"
mkdir -p "$CGSTACK_HOME/projects/$SLUG"

# Validate: input must be parseable JSON (reject malformed or injection attempts)
INPUT="$1"
if ! printf '%s' "$INPUT" | bun -e "JSON.parse(await Bun.stdin.text())" 2>/dev/null; then
  # Not valid JSON — refuse to append
  echo "cgstack-review-log: invalid JSON, skipping" >&2
  exit 1
fi

echo "$INPUT" >> "$CGSTACK_HOME/projects/$SLUG/$BRANCH-reviews.jsonl"

# gbrain-sync: enqueue for cross-machine sync (no-op if sync is off).
"$SCRIPT_DIR/cgstack-brain-enqueue" "projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null &
