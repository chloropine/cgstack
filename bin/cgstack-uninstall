#!/usr/bin/env bash
# cgstack-uninstall — remove cgstack skills, state, and browse daemons
#
# Usage:
#   cgstack-uninstall              — interactive uninstall (prompts before removing)
#   cgstack-uninstall --force      — remove everything without prompting
#   cgstack-uninstall --keep-state — remove skills but keep ~/.cgstack/ data
#
# What gets REMOVED:
#   ~/.codex/skills/cgstack       — global Codex skill install (git clone or vendored)
#   ~/.codex/skills/{skill}      — per-skill symlinks created by setup
#   ~/.codex/skills/cgstack*       — Codex skill install + per-skill symlinks
#   ~/.codex/skills/cgstack*     — Codex Droid skill install + per-skill symlinks
#   ~/.codex/skills/cgstack*        — Codex skill install + per-skill symlinks
#   ~/.cgstack/                    — global state (config, analytics, sessions, projects,
#                                   repos, installation-id, browse error logs)
#   .agents/skills/cgstack*        — project-local skill install (--local installs)
#   .cgstack/                      — per-project browse state (in current git repo)
#   .cgstack-worktrees/            — per-project test worktrees (in current git repo)
#   .agents/skills/cgstack*        — Codex sidecar (in current git repo)
#   Running browse daemons        — stopped via SIGTERM before cleanup
#
# What is NOT REMOVED:
#   ~/Library/Caches/ms-playwright/  — Playwright Chromium (shared, may be used by other tools)
#   ~/.cgstack-dev/                   — developer eval artifacts (only present in cgstack contributors)
#
# Env overrides (for testing):
#   CGSTACK_DIR        — override auto-detected cgstack root
#   CGSTACK_STATE_DIR  — override ~/.cgstack state directory
#
# NOTE: Uses set -uo pipefail (no -e) — uninstall must never abort partway.
set -uo pipefail

if [ -z "${HOME:-}" ]; then
  echo "ERROR: \$HOME is not set" >&2
  exit 1
fi

CGSTACK_DIR="${CGSTACK_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${CGSTACK_STATE_DIR:-$HOME/.cgstack}"
_GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# ─── Parse flags ─────────────────────────────────────────────
FORCE=0
KEEP_STATE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    --keep-state) KEEP_STATE=1; shift ;;
    -h|--help)
      sed -n '2,/^[^#]/{ /^#/s/^# \{0,1\}//p; }' "$0"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: cgstack-uninstall [--force] [--keep-state]" >&2
      exit 1
      ;;
  esac
done

# ─── Confirmation ────────────────────────────────────────────
if [ "$FORCE" -eq 0 ]; then
  echo "This will remove cgstack from your system:"
  { [ -d "$HOME/.codex/skills/cgstack" ] || [ -L "$HOME/.codex/skills/cgstack" ]; } && echo "  ~/.codex/skills/cgstack (+ per-skill symlinks)"
  [ -d "$HOME/.codex/skills" ] && echo "  ~/.codex/skills/cgstack*"
  [ -d "$HOME/.codex/skills" ] && echo "  ~/.codex/skills/cgstack*"
  [ -d "$HOME/.codex/skills" ] && echo "  ~/.codex/skills/cgstack*"
  [ "$KEEP_STATE" -eq 0 ] && [ -d "$STATE_DIR" ] && echo "  $STATE_DIR"

  if [ -n "$_GIT_ROOT" ]; then
    [ -d "$_GIT_ROOT/.agents/skills/cgstack" ] && echo "  $_GIT_ROOT/.agents/skills/cgstack (project-local)"
    [ -d "$_GIT_ROOT/.cgstack" ] && echo "  $_GIT_ROOT/.cgstack/ (browse state + reports)"
    [ -d "$_GIT_ROOT/.cgstack-worktrees" ] && echo "  $_GIT_ROOT/.cgstack-worktrees/"
    [ -d "$_GIT_ROOT/.agents/skills" ] && echo "  $_GIT_ROOT/.agents/skills/cgstack*"
  fi

  # Preview running daemons
  if [ -n "$_GIT_ROOT" ] && [ -f "$_GIT_ROOT/.cgstack/browse.json" ]; then
    _PREVIEW_PID="$(awk -F'[:,]' '/"pid"/ { for(i=1;i<=NF;i++) if($i ~ /"pid"/) { gsub(/[^0-9]/, "", $(i+1)); print $(i+1); exit } }' "$_GIT_ROOT/.cgstack/browse.json" 2>/dev/null || true)"
    [ -n "$_PREVIEW_PID" ] && kill -0 "$_PREVIEW_PID" 2>/dev/null && echo "  browse daemon (PID $_PREVIEW_PID) will be stopped"
  fi

  printf "\nContinue? [y/N] "
  read -r REPLY
  case "$REPLY" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 0 ;;
  esac
fi

REMOVED=()

# ─── Stop running browse daemons ─────────────────────────────
# Browse servers write PID to {project}/.cgstack/browse.json.
# Stop any we can find before removing state directories.
stop_browse_daemon() {
  local state_file="$1"
  if [ ! -f "$state_file" ]; then
    return
  fi
  local pid
  pid="$(awk -F'[:,]' '/"pid"/ { for(i=1;i<=NF;i++) if($i ~ /"pid"/) { gsub(/[^0-9]/, "", $(i+1)); print $(i+1); exit } }' "$state_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    # Wait up to 2s for graceful shutdown
    local waited=0
    while [ "$waited" -lt 4 ] && kill -0 "$pid" 2>/dev/null; do
      sleep 0.5
      waited=$(( waited + 1 ))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    REMOVED+=("browse daemon (PID $pid)")
  fi
}

# Stop daemon in current project
if [ -n "$_GIT_ROOT" ] && [ -f "$_GIT_ROOT/.cgstack/browse.json" ]; then
  stop_browse_daemon "$_GIT_ROOT/.cgstack/browse.json"
fi

# Stop daemons tracked in global projects directory
if [ -d "$STATE_DIR/projects" ]; then
  while IFS= read -r _BJ; do
    stop_browse_daemon "$_BJ"
  done < <(find "$STATE_DIR/projects" -name browse.json -path '*/.cgstack/*' 2>/dev/null || true)
fi

# ─── Remove global Codex skills ────────────────────────────
CODEX_SKILLS="$HOME/.codex/skills"
if [ -d "$CODEX_SKILLS/cgstack" ] || [ -L "$CODEX_SKILLS/cgstack" ]; then
  # Remove per-skill symlinks that point into cgstack/
  for _LINK in "$CODEX_SKILLS"/*; do
    [ -L "$_LINK" ] || continue
    _NAME="$(basename "$_LINK")"
    [ "$_NAME" = "cgstack" ] && continue
    _TARGET="$(readlink "$_LINK" 2>/dev/null || true)"
    case "$_TARGET" in
      cgstack/*|*/cgstack/*) rm -f "$_LINK"; REMOVED+=("codex/$_NAME") ;;
    esac
  done

  rm -rf "$CODEX_SKILLS/cgstack"
  REMOVED+=("~/.codex/skills/cgstack")
fi

# ─── Remove project-local Codex skills (--local installs) ──
if [ -n "$_GIT_ROOT" ] && [ -d "$_GIT_ROOT/.codex/skills" ]; then
  for _LINK in "$_GIT_ROOT/.codex/skills"/*; do
    [ -L "$_LINK" ] || continue
    _TARGET="$(readlink "$_LINK" 2>/dev/null || true)"
    case "$_TARGET" in
      cgstack/*|*/cgstack/*) rm -f "$_LINK"; REMOVED+=("local codex/$(basename "$_LINK")") ;;
    esac
  done
  if [ -d "$_GIT_ROOT/.agents/skills/cgstack" ] || [ -L "$_GIT_ROOT/.agents/skills/cgstack" ]; then
    rm -rf "$_GIT_ROOT/.agents/skills/cgstack"
    REMOVED+=("$_GIT_ROOT/.agents/skills/cgstack")
  fi
fi

# ─── Remove Codex skills ────────────────────────────────────
CODEX_SKILLS="$HOME/.codex/skills"
if [ -d "$CODEX_SKILLS" ]; then
  for _ITEM in "$CODEX_SKILLS"/cgstack*; do
    [ -e "$_ITEM" ] || [ -L "$_ITEM" ] || continue
    rm -rf "$_ITEM"
    REMOVED+=("codex/$(basename "$_ITEM")")
  done
fi

# ─── Remove per-project .agents/ sidecar ─────────────────────
if [ -n "$_GIT_ROOT" ] && [ -d "$_GIT_ROOT/.agents/skills" ]; then
  for _ITEM in "$_GIT_ROOT/.agents/skills"/cgstack*; do
    [ -e "$_ITEM" ] || [ -L "$_ITEM" ] || continue
    rm -rf "$_ITEM"
    REMOVED+=("agents/$(basename "$_ITEM")")
  done

  rmdir "$_GIT_ROOT/.agents/skills" 2>/dev/null || true
  rmdir "$_GIT_ROOT/.agents" 2>/dev/null || true
fi

# ─── Remove per-project .codex/ sidecar ────────────────────
if [ -n "$_GIT_ROOT" ] && [ -d "$_GIT_ROOT/.codex/skills" ]; then
  for _ITEM in "$_GIT_ROOT/.codex/skills"/cgstack*; do
    [ -e "$_ITEM" ] || [ -L "$_ITEM" ] || continue
    rm -rf "$_ITEM"
    REMOVED+=("codex/$(basename "$_ITEM")")
  done

  rmdir "$_GIT_ROOT/.codex/skills" 2>/dev/null || true
  rmdir "$_GIT_ROOT/.codex" 2>/dev/null || true
fi

# ─── Remove per-project state ───────────────────────────────
if [ -n "$_GIT_ROOT" ]; then
  if [ -d "$_GIT_ROOT/.cgstack" ]; then
    rm -rf "$_GIT_ROOT/.cgstack"
    REMOVED+=("$_GIT_ROOT/.cgstack/")
  fi
  if [ -d "$_GIT_ROOT/.cgstack-worktrees" ]; then
    rm -rf "$_GIT_ROOT/.cgstack-worktrees"
    REMOVED+=("$_GIT_ROOT/.cgstack-worktrees/")
  fi
fi

# ─── Remove SessionStart hook from Codex settings ─────
SETTINGS_HOOK="$(dirname "$0")/cgstack-settings-hook"
SESSION_UPDATE="$(dirname "$0")/cgstack-session-update"
if [ -x "$SETTINGS_HOOK" ]; then
  "$SETTINGS_HOOK" remove "$SESSION_UPDATE" 2>/dev/null && REMOVED+=("SessionStart hook") || true
fi

# ─── Remove global state ────────────────────────────────────
if [ "$KEEP_STATE" -eq 0 ] && [ -d "$STATE_DIR" ]; then
  rm -rf "$STATE_DIR"
  REMOVED+=("$STATE_DIR")
fi

# ─── Clean up temp files ────────────────────────────────────
for _TMP in /tmp/cgstack-latest-version /tmp/cgstack-sketch-*.html /tmp/cgstack-sketch.png /tmp/cgstack-sync-*; do
  if [ -e "$_TMP" ]; then
    rm -f "$_TMP"
    REMOVED+=("$(basename "$_TMP")")
  fi
done

# ─── Summary ────────────────────────────────────────────────
if [ ${#REMOVED[@]} -gt 0 ]; then
  echo "Removed: ${REMOVED[*]}"
  echo "cgstack uninstalled."
else
  echo "Nothing to remove — cgstack is not installed."
fi

exit 0
