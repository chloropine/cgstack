#!/usr/bin/env bash
# cgstack setup — build browser binary + install Codex skills
set -e
umask 077

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install Bun from https://bun.sh/ and rerun ./setup." >&2
  exit 1
fi

INSTALL_CGSTACK_DIR="$(cd "$(dirname "$0")" && pwd)"
SOURCE_CGSTACK_DIR="$(cd "$(dirname "$0")" && pwd -P)"
BROWSE_BIN="$SOURCE_CGSTACK_DIR/browse/dist/browse"
CODEX_SKILLS="$HOME/.codex/skills"
CODEX_CGSTACK="$CODEX_SKILLS/cgstack"

IS_WINDOWS=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) IS_WINDOWS=1 ;;
esac

QUIET=0
TEAM_MODE=0
NO_TEAM_MODE=0
HOST="codex"
log() { [ "$QUIET" -eq 0 ] && echo "$@" || true; }
PRINTED_WINDOWS_COPY_NOTE=0

_print_windows_copy_note_once() {
  if [ "$IS_WINDOWS" -eq 1 ] && [ "$PRINTED_WINDOWS_COPY_NOTE" -eq 0 ]; then
    log "Windows install uses file copies because symlinks may require Developer Mode."
    PRINTED_WINDOWS_COPY_NOTE=1
  fi
}

_link_or_copy() {
  local src="$1"
  local dst="$2"
  if [ "$IS_WINDOWS" -eq 1 ]; then
    _print_windows_copy_note_once
    rm -rf "$dst"
    [ -e "$src" ] || return 0
    if [ -d "$src" ]; then
      cp -R "$src" "$dst"
    else
      cp -f "$src" "$dst"
    fi
  else
    ln -snf "$src" "$dst"
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ -z "$2" ] && echo "Missing value for --host (expected codex)" >&2 && exit 1; HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --team) TEAM_MODE=1; shift ;;
    --no-team) NO_TEAM_MODE=1; shift ;;
    -q|--quiet) QUIET=1; shift ;;
    --local|--prefix|--no-prefix)
      echo "Error: $1 was part of the old multi-host installer and is not supported in Codex-only cgstack." >&2
      exit 1 ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1 ;;
  esac
done

case "$HOST" in
  codex) ;;
  *)
    echo "Unknown --host value: $HOST" >&2
    echo "cgstack is Codex-only. Use ./setup or ./setup --host codex." >&2
    exit 1 ;;
esac

CGSTACK_CONFIG="$SOURCE_CGSTACK_DIR/bin/cgstack-config"
export CGSTACK_SETUP_RUNNING=1

migrate_direct_codex_install() {
  local cgstack_dir="$1"
  local codex_cgstack="$2"
  local migrated_dir="$HOME/.cgstack/repos/cgstack"

  [ "$cgstack_dir" = "$codex_cgstack" ] || return 0
  [ -L "$cgstack_dir" ] && return 0

  mkdir -p "$(dirname "$migrated_dir")"
  if [ -e "$migrated_dir" ] && [ "$migrated_dir" != "$cgstack_dir" ]; then
    echo "cgstack setup failed: direct Codex install detected at $cgstack_dir" >&2
    echo "A migrated repo already exists at $migrated_dir; move one of them aside and rerun setup." >&2
    exit 1
  fi

  log "Migrating direct Codex install to $migrated_dir to avoid duplicate skill discovery..."
  mv "$cgstack_dir" "$migrated_dir"
  SOURCE_CGSTACK_DIR="$migrated_dir"
  INSTALL_CGSTACK_DIR="$migrated_dir"
  BROWSE_BIN="$SOURCE_CGSTACK_DIR/browse/dist/browse"
}

migrate_direct_codex_install "$SOURCE_CGSTACK_DIR" "$CODEX_CGSTACK"

ensure_playwright_browser() {
  if [ "$IS_WINDOWS" -eq 1 ]; then
    (
      cd "$SOURCE_CGSTACK_DIR"
      node -e "const { chromium } = require('playwright'); (async () => { const b = await chromium.launch(); await b.close(); })()" 2>/dev/null
    )
  else
    (
      cd "$SOURCE_CGSTACK_DIR"
      bun --eval 'import { chromium } from "playwright"; const browser = await chromium.launch(); await browser.close();'
    ) >/dev/null 2>&1
  fi
}

NEEDS_BUILD=0
if [ ! -x "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ -n "$(find "$SOURCE_CGSTACK_DIR/browse/src" -type f -newer "$BROWSE_BIN" -print -quit 2>/dev/null)" ]; then
  NEEDS_BUILD=1
elif [ "$SOURCE_CGSTACK_DIR/package.json" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ -f "$SOURCE_CGSTACK_DIR/bun.lock" ] && [ "$SOURCE_CGSTACK_DIR/bun.lock" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
  log "Building cgstack..."
  (
    cd "$SOURCE_CGSTACK_DIR"
    bun install --frozen-lockfile 2>/dev/null || bun install
    bun run build
  )
  # macOS Apple Silicon: ad-hoc codesign compiled Bun binaries so Gatekeeper
  # does not quarantine freshly built local tools. Best effort only.
  if [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
    for _bin in browse/dist/browse browse/dist/find-browse design/dist/design make-pdf/dist/pdf bin/cgstack-global-discover; do
      _bin_path="$SOURCE_CGSTACK_DIR/$_bin"
      [ -f "$_bin_path" ] && [ -x "$_bin_path" ] || continue
      codesign --remove-signature "$_bin_path" 2>/dev/null || true
      if ! codesign -s - -f "$_bin_path" >/dev/null 2>&1; then
        echo "warning: codesign failed for $_bin_path" >&2
      fi
    done
  fi
  if [ ! -f "$SOURCE_CGSTACK_DIR/browse/dist/.version" ]; then
    git -C "$SOURCE_CGSTACK_DIR" rev-parse HEAD > "$SOURCE_CGSTACK_DIR/browse/dist/.version" 2>/dev/null || true
  fi
fi

if [ "$NEEDS_BUILD" -eq 0 ]; then
  log "Generating Codex skill docs..."
  (
    cd "$SOURCE_CGSTACK_DIR"
    bun install --frozen-lockfile 2>/dev/null || bun install
    bun run gen:skill-docs
  )
fi

if [ ! -x "$BROWSE_BIN" ]; then
  echo "cgstack setup failed: browse binary missing at $BROWSE_BIN" >&2
  exit 1
fi

if ! ensure_playwright_browser; then
  log "Installing Playwright Chromium..."
  ( cd "$SOURCE_CGSTACK_DIR" && bunx playwright install chromium )
fi

if ! ensure_playwright_browser; then
  echo "cgstack setup failed: Playwright Chromium could not be launched" >&2
  exit 1
fi

create_codex_runtime_root() {
  local cgstack_dir="$1"
  local codex_cgstack="$2"
  local agents_dir="$cgstack_dir/.agents/skills"

  if [ -L "$codex_cgstack" ]; then
    rm -f "$codex_cgstack"
  elif [ -d "$codex_cgstack" ] && [ "$codex_cgstack" != "$cgstack_dir" ]; then
    rm -rf "$codex_cgstack"
  fi

  mkdir -p "$codex_cgstack" "$codex_cgstack/browse" "$codex_cgstack/cgstack-upgrade" "$codex_cgstack/review"
  [ -f "$agents_dir/cgstack/SKILL.md" ] && _link_or_copy "$agents_dir/cgstack/SKILL.md" "$codex_cgstack/SKILL.md"
  [ -d "$agents_dir/cgstack/agents" ] && mkdir -p "$codex_cgstack/agents" && _link_or_copy "$agents_dir/cgstack/agents/openai.yaml" "$codex_cgstack/agents/openai.yaml"
  [ -d "$cgstack_dir/bin" ] && _link_or_copy "$cgstack_dir/bin" "$codex_cgstack/bin"
  [ -d "$cgstack_dir/browse/dist" ] && _link_or_copy "$cgstack_dir/browse/dist" "$codex_cgstack/browse/dist"
  [ -d "$cgstack_dir/browse/bin" ] && _link_or_copy "$cgstack_dir/browse/bin" "$codex_cgstack/browse/bin"
  [ -d "$cgstack_dir/design/dist" ] && mkdir -p "$codex_cgstack/design" && _link_or_copy "$cgstack_dir/design/dist" "$codex_cgstack/design/dist"
  [ -d "$cgstack_dir/make-pdf/dist" ] && mkdir -p "$codex_cgstack/make-pdf" && _link_or_copy "$cgstack_dir/make-pdf/dist" "$codex_cgstack/make-pdf/dist"
  [ -f "$agents_dir/cgstack-upgrade/SKILL.md" ] && _link_or_copy "$agents_dir/cgstack-upgrade/SKILL.md" "$codex_cgstack/cgstack-upgrade/SKILL.md"
  for f in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
    [ -f "$cgstack_dir/review/$f" ] && _link_or_copy "$cgstack_dir/review/$f" "$codex_cgstack/review/$f"
  done
  [ -f "$cgstack_dir/VERSION" ] && _link_or_copy "$cgstack_dir/VERSION" "$codex_cgstack/VERSION"
  [ -f "$cgstack_dir/ETHOS.md" ] && _link_or_copy "$cgstack_dir/ETHOS.md" "$codex_cgstack/ETHOS.md"
}

link_codex_skill_dirs() {
  local cgstack_dir="$1"
  local skills_dir="$2"
  local agents_dir="$cgstack_dir/.agents/skills"
  local linked=()
  [ "$IS_WINDOWS" -eq 1 ] && _print_windows_copy_note_once

  if [ ! -d "$agents_dir" ]; then
    echo "  warning: .agents/skills/ is missing; run 'bun run gen:skill-docs' manually" >&2
    return 1
  fi

  _cleanup_skill_entry() {
    local entry="$1"
    if [ -L "$entry" ]; then
      rm -f "$entry"
    elif [ -d "$entry" ] && [ -L "$entry/SKILL.md" ]; then
      rm -rf "$entry"
    fi
  }

  for skill_dir in "$agents_dir"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    skill_name="$(basename "$skill_dir")"
    [ "$skill_name" = "cgstack" ] && continue
    target="$skills_dir/$skill_name"
    case "$skill_name" in
      cgstack-*) ;;
      *) _cleanup_skill_entry "$skills_dir/cgstack-$skill_name" ;;
    esac
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      _link_or_copy "$skill_dir" "$target"
      linked+=("$skill_name")
    fi
  done
  [ ${#linked[@]} -gt 0 ] && echo "  linked skills: ${linked[*]}"
}

create_agents_sidecar() {
  local repo_root="$1"
  local agents_cgstack="$repo_root/.agents/skills/cgstack"
  mkdir -p "$agents_cgstack"
  for asset in bin browse design make-pdf review qa VERSION ETHOS.md; do
    local src="$SOURCE_CGSTACK_DIR/$asset"
    local dst="$agents_cgstack/$asset"
    if [ -e "$src" ] && { [ -L "$dst" ] || [ ! -e "$dst" ]; }; then
      _link_or_copy "$src" "$dst"
    fi
  done
}

mkdir -p "$HOME/.cgstack/projects" "$CODEX_SKILLS"
create_codex_runtime_root "$SOURCE_CGSTACK_DIR" "$CODEX_CGSTACK"
link_codex_skill_dirs "$SOURCE_CGSTACK_DIR" "$CODEX_SKILLS"
create_agents_sidecar "$SOURCE_CGSTACK_DIR"

MIGRATIONS_DIR="$SOURCE_CGSTACK_DIR/cgstack-upgrade/migrations"
CURRENT_VERSION=$(cat "$SOURCE_CGSTACK_DIR/VERSION" 2>/dev/null || echo "unknown")
LAST_SETUP_VERSION=$(cat "$HOME/.cgstack/.last-setup-version" 2>/dev/null || echo "0.0.0.0")
if [ -d "$MIGRATIONS_DIR" ] && [ "$CURRENT_VERSION" != "unknown" ] && [ "$LAST_SETUP_VERSION" != "$CURRENT_VERSION" ] && [ -f "$HOME/.cgstack/.last-setup-version" ]; then
  find "$MIGRATIONS_DIR" -maxdepth 1 -name 'v*.sh' -type f 2>/dev/null | sort -V | while IFS= read -r migration; do
    m_ver="$(basename "$migration" .sh | sed 's/^v//')"
    if [ "$(printf '%s\n%s' "$LAST_SETUP_VERSION" "$m_ver" | sort -V | head -1)" = "$LAST_SETUP_VERSION" ] && [ "$LAST_SETUP_VERSION" != "$m_ver" ] \
       && [ "$(printf '%s\n%s' "$m_ver" "$CURRENT_VERSION" | sort -V | tail -1)" = "$CURRENT_VERSION" ]; then
      echo "  running migration $m_ver..."
      bash "$migration" || echo "  warning: migration $m_ver had errors (non-fatal)"
    fi
  done
fi

mkdir -p "$HOME/.cgstack"
[ "$CURRENT_VERSION" != "unknown" ] && echo "$CURRENT_VERSION" > "$HOME/.cgstack/.last-setup-version"
if [ ! -f "$HOME/.cgstack/.welcome-seen" ]; then
  log "  Welcome! Run \$cgstack-upgrade anytime to stay current."
  touch "$HOME/.cgstack/.welcome-seen"
fi
rm -f /tmp/cgstack-latest-version

if [ "$TEAM_MODE" -eq 1 ]; then
  "$CGSTACK_CONFIG" set auto_upgrade true 2>/dev/null || true
  "$CGSTACK_CONFIG" set team_mode true 2>/dev/null || true
  log ""
  log "Team mode enabled for Codex."
  log "Bootstrap your repo:"
  log "  cd <your-repo> && $SOURCE_CGSTACK_DIR/bin/cgstack-team-init required"
fi

if [ "$NO_TEAM_MODE" -eq 1 ]; then
  "$CGSTACK_CONFIG" set auto_upgrade false 2>/dev/null || true
  "$CGSTACK_CONFIG" set team_mode false 2>/dev/null || true
  log "Team mode disabled."
fi

log "cgstack ready (codex)."
log "  browse: $BROWSE_BIN"
log "  codex skills: $CODEX_SKILLS"
